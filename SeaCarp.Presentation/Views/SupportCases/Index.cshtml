@using SeaCarp.Infrastructure
@model SeaCarp.Presentation.Models.ViewModels.SupportCaseViewModel

<div class="container mt-4">
    <h2 class="mb-4">Support Case: @Model.CaseNumber</h2>

    <div class="card mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Case Details</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <p><strong>Case ID:</strong> @Model.Id</p>
                    <p><strong>Created Date:</strong> @Model.CreatedDate</p>
                    <p><strong>Status:</strong> <span class="badge bg-secondary">@Model.Status</span></p>
                    <p><strong>Case Officer:</strong> @(string.IsNullOrWhiteSpace(Model.CaseOfficer.Value) ? "Unassigned" : Model.CaseOfficer.Value)</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Description:</strong></p>
                    <div class="border p-3 bg-light">@Model.Description</div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Image.Value))
            {
                <div class="mt-3">
                    <p><strong>Attached Image:</strong></p>
                    <img style="max-width: 400px; max-height: 400px" src="@Model.Image"></img>
                </div>
            }
        </div>
    </div>

    @if (RequestContext.Instance?.CurrentUser?.Value?.IsCaseOfficer ?? false)
    {
        <div class="card mb-4">
            <div class="card-header bg-secondary text-white">
                <h5 class="mb-0">Case Officer Notes</h5>
            </div>
            <div class="card-body">
                @if (Model.Notes != null && Model.Notes.Any())
                {
                    <div class="list-group">
                        @foreach (var note in Model.Notes.OrderByDescending(n => n.Id))
                        {
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div>
                                        <strong>@(string.IsNullOrWhiteSpace(note.CaseOfficerUsername.Value) ? "Staff" : note.CaseOfficerUsername.Value)</strong>
                                    </div>
                                    <small class="text-muted">@note.CreatedDate</small>
                                </div>
                                <div class="mt-2">@note.Note</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted">No notes have been added yet.</div>
                }
            </div>
        </div>
    
        <div class="card mb-4">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">Case Officer Panel</h5>
            </div>
            <div class="card-body">
                <div class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <button id="claimCaseBtn" type="button" class="btn btn-outline-primary w-100">Claim case</button>
                    </div>

                    <div class="col-md-3">
                        <label for="caseStatus" class="form-label">Update Status</label>
                        <select id="caseStatus" class="form-select">
                            <option value="InProgress">In Progress</option>
                            <option value="Resolved">Resolved</option>
                            <option value="Closed">Closed</option>
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label for="note" class="form-label">Internal Note</label>
                        <input id="note" class="form-control" maxlength="500" placeholder="Saved and visible only to staff" />
                    </div>

                    <div class="col-md-3">
                        <button id="updateStatusBtn" type="button" class="btn btn-primary w-100">Update Status Changes</button>
                    </div>

                    <div class="col-md-3">
                        <button id="addNoteBtn" type="button" class="btn btn-outline-secondary w-100">Add Note</button>
                    </div>

                    <div class="col-md-3">
                        <button id="reopenBtn" type="button" class="btn btn-outline-warning w-100">Reopen</button>
                    </div>

                    <div class="col-md-3">
                        <button id="unassignBtn" type="button" class="btn btn-outline-danger w-100">Unassign</button>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (Model.Order != null)
    {
        <div class="card mb-4">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Related Order Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <p><strong>Order Number:</strong> @Model.Order.OrderNumber</p>
                        <p><strong>Order Date:</strong> @Model.Order.OrderDate</p>
                        <p><strong>Status:</strong> <span class="badge bg-secondary">@Model.Order.Status</span></p>
                    </div>
                    <div class="col-md-6">
                        <p><strong>Buyer:</strong> @Model.Order.Buyer</p>
                        <p><strong>Delivery Address:</strong> @Model.Order.DeliveryAddress</p>
                        <p><strong>Total:</strong> $@Model.Order.Total.ToString("F2")</p>
                    </div>
                </div>

                @if (Model.Order.OrderItems != null && Model.Order.OrderItems.Any())
                {
                    <div class="mt-4">
                        <h6>Order Items</h6>
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Item</th>
                                    <th>Quantity</th>
                                    <th>Price</th>
                                    <th>Subtotal</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Order.OrderItems)
                                {
                                    <tr>
                                        <td>@item.Product.ProductName</td>
                                        <td>@item.Quantity</td>
                                        <td>$@item.UnitPrice.ToString("F2")</td>
                                        <td>$@((item.UnitPrice * item.Quantity).ToString("F2"))</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function readJwt() {
            const jwtCookie = document.cookie.split('; ').find(row => row.startsWith('JWT='));
            if (!jwtCookie) return null;
            return jwtCookie.substring('JWT='.length);
        }

        window.addEventListener('DOMContentLoaded', () => {
            const identifier = '@Model.CaseNumber';

            const claimBtn = document.querySelector('#claimCaseBtn');
            const updateBtn = document.querySelector('#updateStatusBtn');
            const addNoteBtn = document.querySelector('#addNoteBtn');
            const reopenBtn = document.querySelector('#reopenBtn');
            const unassignBtn = document.querySelector('#unassignBtn');

            if (claimBtn) {
                claimBtn.addEventListener('click', () => {
                    makeAuthorizedRequest(
                        `/api/v1/supportcases/${identifier}/claim`,
                        'PUT');
                });
            }

            function getNote() {
                return document.querySelector('#note')?.value;
            }

            if (updateBtn) {
                updateBtn.addEventListener('click', () => {
                    const status = document.querySelector('#caseStatus')?.value;
                    makeAuthorizedRequest(
                        `/api/v1/supportcases/${identifier}/status`,
                        'PUT',
                        { status: status });
                });
            }

            if (addNoteBtn) {
                addNoteBtn.addEventListener('click', () => {
                    makeAuthorizedRequest(
                        `/api/v1/supportcases/${identifier}/note`,
                        'POST',
                        { note: getNote() });
                });
            }

            if (reopenBtn) {
                reopenBtn.addEventListener('click', () => {
                    makeAuthorizedRequest(
                        `/api/v1/supportcases/${identifier}/reopen`,
                        'PUT');
                });
            }

            if (unassignBtn) {
                unassignBtn.addEventListener('click', () => {
                    makeAuthorizedRequest(
                        `/api/v1/supportcases/${identifier}/unassign`,
                        'PUT');
                });
            }
        });
    </script>
}
