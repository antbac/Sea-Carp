@model SeaCarp.Presentation.Models.ViewModels.SystemViewModel
@{
    ViewData["Title"] = "System information";
}

<div class="container mt-4">
    <h2>System Information</h2>
    <p>This page provides useful endpoints and information for system administrators and developers.</p>
    <ul>
        <li>
            <strong>System Logs:</strong> <a href="/system/logs"><code>/system/logs</code></a><br />
            <span>Access and review the application logs for diagnostics and troubleshooting.</span>
        </li>
    </ul>

    <h3>Other Information</h3>
    <ul>
        <li>Application version: <span>@Model.CurrentVersion</span></li>
        <li>Environment: <span>Production</span></li>
        <li>Last deployment: <span>@Model.LastDeployment</span></li>
        <li>Deployment configuration: <span>@Model.DeploymentTechnology</span></li>
        <li>Local port: <span>@Model.LocalPort</span></li>
    </ul>

    <h2>Password Security</h2>
    <p>
        We take security seriously. All user passwords are stored in a hashed format using a unique salt for our application.
        This approach helps protect user credentials and ensures compliance with modern security best practices.
    </p>

    <h2>Additional support</h2>
    <p>
        For more details, contact your system administrator @Model.AdminEmail or refer to the project documentation over on <a href="@Model.RepositoryUrl">GitHub</a>
    </p>
</div>
