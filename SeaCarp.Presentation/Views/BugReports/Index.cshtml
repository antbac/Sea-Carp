@{
    ViewData["Title"] = "Bug Reports";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">File a Bug Report</h2>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Report Details</h5>
        </div>
        <div class="card-body">
            <form id="bugreport_form">
                <div class="mb-3">
                    <label for="Title" class="form-label">Title</label>
                    <input id="Title"
                           name="Title"
                           class="form-control"
                           required
                           maxlength="100"
                           placeholder="Short summary" />
                </div>

                <div class="mb-3">
                    <label for="Description" class="form-label">Description</label>
                    <textarea id="Description"
                              name="Description"
                              class="form-control"
                              required
                              maxlength="2000"
                              rows="6"
                              placeholder="Steps to reproduce, expected vs. actual behavior, etc."></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button id="submitBugReportBtn" type="submit" class="btn btn-primary">Submit</button>
                    <button type="reset" class="btn btn-outline-secondary">Clear</button>
                </div>

                <div id="bugreport_success" class="alert alert-success mt-3" style="display:none"></div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.addEventListener('DOMContentLoaded', () => {
            const form = document.querySelector('#bugreport_form');
            const successDiv = document.querySelector('#bugreport_success');

            if (!form) return;

            form.onsubmit = (e) => {
                e.preventDefault();

                if (!form.checkValidity()) {
                    form.reportValidity();
                    return;
                }

                const title = document.querySelector('#Title')?.value;
                const description = document.querySelector('#Description')?.value;

                makeAuthorizedRequest(
                    '/api/v1/bugreports',
                    'POST',
                    { title: title, description: description });
            };
        });
    </script>
}
